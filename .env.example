# Slack tokens (required)
SLACK_APP_TOKEN=xapp-1-...
SLACK_BOT_TOKEN=xoxb-...

# Goldfish configuration
GOLDFISH_WORKSPACE=/path/to/your/agent-workspace
GOLDFISH_DM_CHANNEL_ID=
GOLDFISH_CHANNELS=
GOLDFISH_MAX_TURNS=50
GOLDFISH_TIMEOUT_MS=900000
GOLDFISH_SESSION_EXPIRY_MS=86400000
GOLDFISH_SHOW_THINKING=true

# Agent backend: claude (default) or codex.
GOLDFISH_BACKEND=claude
# Optional per-channel provider routing. Quote JSON with single quotes.
# GOLDFISH_BACKEND_BY_CHANNEL='{"C0CLAUDE123":"claude","C0CODEX456":"codex"}'

# Shared reasoning effort. Claude: low..max. Codex also supports minimal/ultra.
# Lower = faster/shallower, higher = slower/more deliberate. Leave unset for the CLI default.
GOLDFISH_EFFORT=
# Per-channel overrides as a JSON map of channelId -> level. Beats GOLDFISH_EFFORT.
# IMPORTANT: wrap the value in SINGLE quotes — .env is sourced by bash (launchd/goldfish-env.sh),
# which strips double quotes and would corrupt the JSON into an empty map.
# GOLDFISH_EFFORT_BY_CHANNEL='{"C0CASUAL123":"low","C0WORK456":"high"}'

# Provider-specific model defaults. Leave unset to use each CLI's default.
GOLDFISH_CLAUDE_MODEL=
GOLDFISH_CODEX_MODEL=
GOLDFISH_CLAUDE_PATH=claude
# GOLDFISH_CLAUDE_MODEL_BY_CHANNEL='{"C0CASUAL123":"haiku"}'
# GOLDFISH_CODEX_MODEL_BY_CHANNEL='{"C0WORK456":"gpt-6-astra"}'

# Deprecated compatibility aliases for Claude only:
# GOLDFISH_MODEL=
# GOLDFISH_MODEL_BY_CHANNEL='{"C0CASUAL123":"haiku"}'

# Codex runtime and unattended execution policy. Leave PATH unset to use the
# CLI version pinned and bundled by @openai/codex-sdk.
# GOLDFISH_CODEX_PATH=/absolute/path/to/codex
GOLDFISH_CODEX_SANDBOX=workspace-write
GOLDFISH_CODEX_NETWORK=true
GOLDFISH_CODEX_WEB_SEARCH=cached
# Extra writable roots, separated by the platform path delimiter (`:` on macOS/Linux).
# GOLDFISH_CODEX_ADDITIONAL_DIRECTORIES=/path/one:/path/two

# Scheduled synthesis inherits GOLDFISH_BACKEND unless overridden here or in schedule.yaml.
# GOLDFISH_SYNTHESIS_BACKEND=codex
# GOLDFISH_SYNTHESIS_MODEL=gpt-6-astra
# GOLDFISH_SYNTHESIS_EFFORT=medium
